  },
  "scripts": {
    "dev": "vite dev --port 9090",
    "dev:worker": "wrangler dev --port 9090",
    "dev:log": "vite dev --port 9090 2>&1 | tee /tmp/agent-config-dev.log",
    "logs": "tail -f /tmp/agent-config-dev.log",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node ./scripts/maybe-vite-build.mjs",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src",
    "d1:migrations:apply": "wrangler d1 migrations apply agent-config-adapter"
  },
