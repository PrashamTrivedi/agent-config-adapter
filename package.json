    "lucide-react": "^1.39.0",
    "mimetext": "^3.0.27",
    "nanoid": "^3.3.11",
    "openai": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smol-toml": "^1.4.2",
    "zod": "^3.25.76"
